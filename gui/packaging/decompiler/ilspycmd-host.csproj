<!-- Self-contained host for the unmodified ilspycmd 9.1.0.7988 (MIT).
     Build (needs the .NET 9 SDK). An XML comment cannot contain two hyphens in a row, so the flags are written without them:
       dotnet tool install -g ilspycmd -v 9.1.0.7988
       dotnet publish -c Release -r win-x64 -p:SelfContained=true -o out-win -p:IlspyToolDir=TOOLS/net8.0/any
     TOOLS is the ilspycmd package directory tools/net8.0/any.
     The output folder ships as DeckBench\decompiler\ so players do not need the .NET SDK. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>ilspycmd-host</AssemblyName>
    <RootNamespace>IlspyHost</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- File version is stamped at publish from sts2sim.__version__ (gui/packaging/read_version.py). Do not write a second version number here. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Company>DeckBench</Company>
    <Product>DeckBench</Product>
    <Description>DeckBench decompiler host</Description>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(IlspyToolDir)/*.dll" Exclude="$(IlspyToolDir)/System.Collections.Immutable.dll;$(IlspyToolDir)/System.Reflection.Metadata.dll"><Private>true</Private></Reference>
  </ItemGroup>
</Project>
